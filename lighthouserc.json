{
	"ci": {
		"collect": {
			"startServerCommand": "pnpm preview",
			"startServerReadyPattern": "Local",
			"url": ["http://localhost:4173/", "http://localhost:4173/shared"],
			"numberOfRuns": 3,
			"settings": {
				"preset": "desktop"
			}
		},
		"assert": {
			"assertMatrix": [
				{
					"matchingUrlPattern": "localhost:4173/$",
					"assertions": {
						"categories:performance": [
							"error",
							{
								"minScore": 0.9
							}
						],
						"categories:accessibility": [
							"error",
							{
								"minScore": 1
							}
						],
						"categories:best-practices": [
							"error",
							{
								"minScore": 0.95
							}
						],
						"categories:seo": [
							"error",
							{
								"minScore": 0.9
							}
						],
						"largest-contentful-paint": [
							"error",
							{
								"maxNumericValue": 2500
							}
						],
						"cumulative-layout-shift": [
							"error",
							{
								"maxNumericValue": 0.1
							}
						],
						"total-blocking-time": [
							"error",
							{
								"maxNumericValue": 200
							}
						]
					}
				},
				{
					"matchingUrlPattern": "/shared",
					"assertions": {
						"categories:performance": [
							"error",
							{
								"minScore": 0.9
							}
						],
						"categories:accessibility": [
							"error",
							{
								"minScore": 1
							}
						],
						"categories:best-practices": [
							"error",
							{
								"minScore": 0.95
							}
						],
						"largest-contentful-paint": [
							"error",
							{
								"maxNumericValue": 2500
							}
						],
						"cumulative-layout-shift": [
							"error",
							{
								"maxNumericValue": 0.1
							}
						],
						"total-blocking-time": [
							"error",
							{
								"maxNumericValue": 200
							}
						]
					}
				}
			]
		},
		"upload": {
			"target": "temporary-public-storage"
		}
	}
}
