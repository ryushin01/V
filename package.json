{
	"name": "v",
	"version": "0.6.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && cp build/spa.html build/404.html",
		"preview": "vite preview --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"lint:fsd": "steiger ./src",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@feature-sliced/steiger-plugin": "^0.8.2",
		"@playwright/test": "^1.65.0",
		"@storybook/addon-a11y": "^10.6.6",
		"@storybook/sveltekit": "^10.6.6",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"fake-indexeddb": "^6.2.7",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sirv-cli": "^3.0.1",
		"steiger": "^0.9.0",
		"storybook": "^10.6.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@fontsource-variable/roboto-condensed": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/sunflower": "^5.3.1"
	},
	"packageManager": "pnpm@12.16.1",
	"imports": {
		"#pages/*": "./src/pages/*/index.ts",
		"#features/*": "./src/features/*/index.ts",
		"#entities/*": "./src/entities/*/index.ts",
		"#shared/*": "./src/shared/*/index.ts"
	}
}
