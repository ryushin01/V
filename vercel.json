{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"buildCommand": "pnpm build",
	"outputDirectory": "build",
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/plans/[^/]+/?$",
			"dest": "/spa.html"
		},
		{
			"src": "^/shared/?$",
			"dest": "/shared.html"
		},
		{
			"src": "^/.*$",
			"status": 404,
			"dest": "/404.html"
		}
	]
}
